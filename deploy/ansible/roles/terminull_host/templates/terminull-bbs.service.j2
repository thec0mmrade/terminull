# {{ ansible_managed }}
[Unit]
Description=terminull SSH BBS
After=network.target

[Service]
Type=simple
User=terminull
EnvironmentFile={{ deploy_path }}/current/bbs.env
ExecStart={{ deploy_path }}/current/bin/terminull-ssh
# Bind port 22 without running as root.
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
Restart=on-failure
RestartSec=5
# Hardening
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
# The BBS generates and keeps its host key here.
ReadWritePaths={{ deploy_path }}/shared
MemoryMax=512M

[Install]
WantedBy=multi-user.target
