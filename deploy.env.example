# Copy to deploy.env (gitignored) and fill in. Placeholders only.

# Public site URL; https (http allowed only for localhost). Baked into the build.
TERMINULL_SITE_URL=https://terminull.example.com

# Server hostname or IP to deploy to.
DEPLOY_HOST=terminull.example.com

# SSH user on the server.
DEPLOY_USER=deploy

# SSH port used for deploys (the admin sshd, not the BBS).
DEPLOY_SSH_PORT=2200

# Absolute directory on the server holding releases (default /srv/terminull).
DEPLOY_PATH=/srv/terminull

# Server CPU architecture: amd64 or arm64 (default amd64).
DEPLOY_ARCH=amd64

# Public port the SSH BBS listens on (default 22).
BBS_PORT=22

# Number of releases to keep on the server, minimum 2 (default 5).
KEEP_RELEASES=5

# Zine volumes directory, absolute or relative to the repo root (default src/content/volumes).
TERMINULL_VOLUMES_DIR=src/content/volumes

# Optional: browser used for the zine PDF export; passed through to builds.
# PUPPETEER_EXECUTABLE_PATH=/usr/bin/chromium
