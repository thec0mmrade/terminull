---
// An article that is one piece of BBS ANSI art, drawn in cell by cell at
// modem speed.
//
// The finished art is rendered to HTML at build time, so it reads fine
// without JavaScript. The script only replays the original byte stream to
// move a cursor, and reveals the static rows up to that cursor.
import fs from 'node:fs';
import { parseAnsiArt, ansiRowsToHtml, ansiMeta, ansiCredit, ANSI_COLS } from '../lib/ansi-art.js';

interface Props {
  /** Absolute path to the .ANS file. */
  file: string;
  baud?: number;
}

const { file, baud = 9600 } = Astro.props;
const bytes = new Uint8Array(fs.readFileSync(file));
const art = parseAnsiArt(bytes);
const html = ansiRowsToHtml(art.rows);
const stream = Buffer.from(art.body).toString('base64');
const credit = ansiCredit(ansiMeta(file.replace(/.*[\\/]/, ''), bytes));
---

<div class="ansi-scroller" data-stream={stream} data-baud={baud}>
  <div class="ansi-credit">{credit} · {ANSI_COLS}×{art.rows.length} · {baud} baud</div>
  <div class="ansi-viewport">
    <div class="ansi-screen" role="img" aria-label={`ANSI art: ${credit}`} set:html={html} />
  </div>
</div>

<script>
  import { advanceCursor } from '../lib/ansi-art.js';

  const CELL_W = 9; // px: IBM VGA 9x16 at 16px
  const BOTTOM_BARS = 110; // px covered by the fixed status bar + prompt
  const MAX_FRAME_MS = 100; // longer gaps (hidden tab) pause the drawing

  function play(el: HTMLElement) {
    const screen = el.querySelector<HTMLElement>('.ansi-screen');
    if (!screen || !el.dataset.stream) return;
    if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;

    const rows = Array.from(screen.children) as HTMLElement[];
    const bytesPerMs = (Number(el.dataset.baud) || 9600) / 10 / 1000; // 8N1: 10 bits per byte
    const bytes = Uint8Array.from(atob(el.dataset.stream), c => c.charCodeAt(0));

    const cursor = { pos: 0, row: 0, col: 0 };
    let shown = -1; // last row made visible
    let elapsed = 0; // ms of drawing time, excluding pauses
    let last = performance.now();

    el.classList.add('is-drawing');

    function edgeVisible() {
      if (shown < 0) return true;
      const r = rows[Math.min(shown, rows.length - 1)].getBoundingClientRect();
      return r.bottom > 0 && r.bottom <= window.innerHeight - BOTTOM_BARS + 24;
    }

    // The view follows the drawing edge until the reader scrolls away from
    // it, and picks the follow back up when they return to the edge.
    let following = true;
    let ownScrollAt = 0;
    const onScroll = () => {
      if (performance.now() - ownScrollAt < 150) return;
      following = edgeVisible();
    };
    window.addEventListener('scroll', onScroll, { passive: true });

    function draw() {
      const edge = Math.min(cursor.row, rows.length - 1);
      if (edge > shown) {
        for (let r = Math.max(shown, 0); r < edge; r++) rows[r].style.width = '';
        for (let r = shown + 1; r <= edge; r++) rows[r].classList.add('on');
        shown = edge;
        if (following) {
          const over = rows[edge].getBoundingClientRect().bottom - (window.innerHeight - BOTTOM_BARS);
          if (over > 0) {
            ownScrollAt = performance.now();
            window.scrollBy({ top: over, behavior: 'instant' });
          }
        }
      }
      if (cursor.row < rows.length) rows[edge].style.width = `${cursor.col * CELL_W}px`;
    }

    function finish() {
      window.removeEventListener('scroll', onScroll);
      el.classList.remove('is-drawing');
      for (const r of rows) { r.style.width = ''; r.classList.remove('on'); }
    }

    function frame(now: number) {
      if (!el.isConnected) {
        window.removeEventListener('scroll', onScroll);
        return;
      }
      elapsed += Math.min(now - last, MAX_FRAME_MS);
      last = now;
      advanceCursor(bytes, cursor, Math.floor(elapsed * bytesPerMs));
      draw();
      if (cursor.pos < bytes.length) requestAnimationFrame(frame);
      else finish();
    }
    requestAnimationFrame(frame);
  }

  document.querySelectorAll<HTMLElement>('.ansi-scroller').forEach(play);
</script>

<style is:global>
  @font-face {
    font-family: 'IBM VGA 9x16';
    src: url('/fonts/Web437_IBM_VGA_9x16.woff') format('woff');
    font-display: block;
  }

  .ansi-credit {
    color: var(--text-muted);
    font-size: 1.125rem;
    margin-bottom: 0.75rem;
  }

  /* Narrow screens scroll sideways rather than scale: the grid is exact. */
  .ansi-viewport {
    overflow-x: auto;
  }

  /* 80 columns x 9px cells, 16px rows: VGA text mode, pixel for pixel. */
  .ansi-screen {
    width: 720px;
    background: #000;
    font-family: 'IBM VGA 9x16', 'IBM Plex Mono', monospace;
    font-size: 16px;
    line-height: 16px;
    letter-spacing: 0;
    font-variant-ligatures: none;
    font-kerning: none;
    -webkit-font-smoothing: none;
    font-smooth: never;
    text-rendering: optimizeSpeed;
    white-space: pre;
  }

  .ansi-row {
    height: 16px;
    overflow: hidden;
  }

  .ansi-scroller.is-drawing .ansi-row { display: none; }
  .ansi-scroller.is-drawing .ansi-row.on { display: block; }

  /* VGA text-mode palette */
  .ansi-screen .f0 { color: #000; }     .ansi-screen .b0 { background: #000; }
  .ansi-screen .f1 { color: #a00; }     .ansi-screen .b1 { background: #a00; }
  .ansi-screen .f2 { color: #0a0; }     .ansi-screen .b2 { background: #0a0; }
  .ansi-screen .f3 { color: #a50; }     .ansi-screen .b3 { background: #a50; }
  .ansi-screen .f4 { color: #00a; }     .ansi-screen .b4 { background: #00a; }
  .ansi-screen .f5 { color: #a0a; }     .ansi-screen .b5 { background: #a0a; }
  .ansi-screen .f6 { color: #0aa; }     .ansi-screen .b6 { background: #0aa; }
  .ansi-screen .f7 { color: #aaa; }     .ansi-screen .b7 { background: #aaa; }
  .ansi-screen .f8 { color: #555; }
  .ansi-screen .f9 { color: #f55; }
  .ansi-screen .f10 { color: #5f5; }
  .ansi-screen .f11 { color: #ff5; }
  .ansi-screen .f12 { color: #55f; }
  .ansi-screen .f13 { color: #f5f; }
  .ansi-screen .f14 { color: #5ff; }
  .ansi-screen .f15 { color: #fff; }
</style>
